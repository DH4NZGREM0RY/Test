# ============================================================
# rpg-multibot environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# Every secret is read from here; nothing is hardcoded.
# ============================================================

# ---------- General ----------
NODE_ENV=production                     # production | development | test
LOG_LEVEL=info                          # fatal|error|warn|info|debug|trace
LOG_TO_FILE=true                        # also write pino logs to data/logs/
TZ=UTC                                  # keep cron/scheduler deterministic

# ---------- Paths (defaults are fine for Docker + PM2) ----------
DATA_DIR=./data                         # root of runtime data (db, backups, cache, locks, logs)
DB_PATH=./data/db/bot.db                # SQLite file (WAL mode)
CACHE_DIR=./data/cache                  # rendered images + previews
LOCK_DIR=./data/locks                   # single-instance lock files

# ---------- Health server ----------
HEALTH_PORT=8787                        # GET /health -> per-account status JSON

# ---------- Discord ----------
# Create apps at https://discord.com/developers/applications
# Bot needs: Message Content intent (privileged) + Guilds/Members/GDM messages.
DISCORD_ENABLED=true
DISCORD_TOKEN=                          # bot token for the default discord-main account
DISCORD_CLIENT_ID=                      # application id (for slash-command registration)
DISCORD_GUILD_ID=                       # optional: register commands to one guild for instant sync

# ---------- Telegram ----------
# Get a token from @BotFather. For group keyword-summoning & chat counting,
# turn OFF privacy mode in BotFather (/setprivacy).
TELEGRAM_ENABLED=true
TELEGRAM_TOKEN=

# ---------- WhatsApp (Baileys) ----------
# Multi-device. Session is persisted to data/wa_auth/<accountId>/ so you scan
# the QR only once; restarts never require re-scanning.
WHATSAPP_ENABLED=false
WA_ACCOUNT_ID=whatsapp-main             # session folder: data/wa_auth/whatsapp-main/

# Per-account credentials live in bot-accounts.json (see bot-accounts.example.json).
# The *_TOKEN vars above are the defaults used when an account omits tokenEnv.

# ---------- AI provider (any OpenAI-compatible chat-completions endpoint) ----------
# Works with: Qwen compatible-mode, Ollama (http://localhost:11434/v1), vLLM, OpenRouter.
AI_ENABLED=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=                             # leave empty for Ollama/vLLM local endpoints
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_CONCURRENCY=2                        # global in-flight AI requests
AI_KEYWORD_STRICT=true                  # true: first word must be a bare keyword (no symbols)
AI_SESSION_IDLE_SECONDS=300             # persona stays engaged this long after last message
AI_CONTEXT_TURNS=12                     # rolling window of stored turns sent as context
AI_PER_USER_COOLDOWN_MS=3000
AI_USER_DAILY_TOKEN_BUDGET=20000        # per player, per UTC day
AI_CHAT_DAILY_TOKEN_BUDGET=120000       # per chat, per UTC day

# ---------- Game ----------
DEFAULT_LANGUAGE=en                     # en | id
DAILY_COOLDOWN_HOURS=20                 # daily reward window
WEEKLY_COOLDOWN_HOURS=150               # weekly reward window
WORLD_BOSS_CRON_MINUTES=180             # world boss spawns every N minutes

# ---------- Ops ----------
MAINTENANCE_MODE=false                  # if true, only admins can use commands
ADMIN_USER_IDS=                         # comma-separated platform user ids treated as admin
BACKUP_INTERVAL_MINUTES=60
BACKUP_KEEP=24                          # number of backups kept in data/backups
ACTIVITY_FLUSH_SECONDS=10               # activity buffer flush cadence (also flushed on shutdown)
RESTART_ANNOUNCE_THRESHOLD_SECONDS=60   # announce "back online" only after downtime > this
