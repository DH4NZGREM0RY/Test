{
  "name": "rpg-multibot",
  "version": "0.1.0",
  "description": "Semi-RPG multi-platform chatbot (Discord + Telegram + WhatsApp) with AI personas, one shared codebase and one shared SQLite database.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "register-commands": "tsx scripts/register-discord-commands.ts",
    "docs:commands": "tsx scripts/generate-command-docs.ts",
    "check:structure": "tsx scripts/check-structure.ts",
    "check:personas": "tsx scripts/check-personas.ts",
    "render:preview": "tsx scripts/render-preview.ts",
    "verify:restart": "tsx scripts/verify-restart.ts",
    "check": "npm run typecheck && npm run lint && npm run check:structure && npm run test"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@whiskeysockets/baileys": "^6.7.9",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.16.3",
    "grammy": "^1.34.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.10",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
